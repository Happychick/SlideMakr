modules = ["web", "python-3.12", "postgresql-16"]
run = "python server.py"

[nix]
channel = "stable-24_05"
packages = ["alsa-lib", "ffmpeg-full", "libsndfile", "pkg-config", "portaudio", "python310Packages.pyaudio"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Run Server"
author = 39418602
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python server.py"

[[workflows.workflow]]
name = "Test Server"
author = 39418602
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python server.py"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "python server.py"]

[agent]
expertMode = true
