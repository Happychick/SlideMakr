modules = ["web", "python-3.12", "postgresql-16"]
run = "python server.py"

[nix]
channel = "stable-24_05"
packages = ["alsa-lib", "ffmpeg-full", "libsndfile", "pkg-config", "portaudio", "python310Packages.pyaudio"]

[workflows]
runButton = "Run Server"

[[workflows.workflow]]
name = "Run Server"
author = 39418602
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python server.py"

[[workflows.workflow]]
name = "Test Server"
author = 39418602
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python server.py"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "python server.py"]
